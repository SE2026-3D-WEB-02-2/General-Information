+      req.params.id,
+      req.actorId,
+      {
+        expectedVersion: req.body.expectedVersion,
+        // Standard Idempotency-Key HTTP header wins; body field is accepted as a fallback.
+        idempotencyKey: req.idempotencyKey ?? req.body.idempotencyKey,
+      },
+      req.actorRole ?? 'REVIEWER',
+    );
