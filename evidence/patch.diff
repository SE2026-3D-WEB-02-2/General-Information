+  /** Reviewer approval endpoint (VT-087): maps service outcome to HTTP status. */
+  public async approveAnnotation(req: {
+    params: { id: string };
+    actorId: string;
+    actorRole?: UserRole;
+    body: { expectedVersion: number; idempotencyKey?: string };
+    idempotencyKey?: string;
