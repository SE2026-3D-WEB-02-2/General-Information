{
  "name": "spriter-3d-review",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "spriter-3d-review",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ]
    },
    "apps/api": {
      "name": "@spriter/api",
      "version": "0.1.0",
      "dependencies": {
        "@spriter/shared": "*"
      }
    },
    "apps/web": {
      "name": "@spriter/web",
      "version": "0.1.0",
      "dependencies": {
        "@spriter/shared": "*"
      }
    },
    "node_modules/@spriter/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@spriter/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@spriter/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@spriter/shared",
      "version": "0.1.0"
    }
  }
}
